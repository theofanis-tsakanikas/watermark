# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv-checkov/

# Terraform
.terraform/
# `.terraform.lock.hcl` IS committed. Provider versions that resolve differently between a
# validation run and a deploy make "validated" mean nothing.
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json

# Secrets — never
.env
.env.*
*.pem
*.key
credentials.json
.bootstrap_outputs.json

# Build output — everything under out/ is generated by a command in this repository
out/
build/
dist/

# Savepoints and checkpoints captured during a recovery drill. The *assertions* about them
# are committed; the binaries are not.
savepoints/

# macOS
.DS_Store
infra/streaming/.package/
infra/*/.build/
