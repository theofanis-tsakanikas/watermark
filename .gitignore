# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv-checkov/

# Terraform
.terraform/
# `.terraform.lock.hcl` IS committed. Provider versions that resolve differently between a
# validation run and a deploy make "validated" mean nothing.
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json

# Secrets — never
.env
.env.*
*.pem
*.key
credentials.json
.bootstrap_outputs.json

# Build output — everything under out/ is generated by a command in this repository
out/
build/
dist/

# Savepoints and checkpoints captured during a recovery drill. The *assertions* about them
# are committed; the binaries are not.
savepoints/

# macOS
.DS_Store
infra/streaming/.package/
infra/*/.build/
pipelines/dbt/target/
pipelines/dbt/dbt_packages/
infra/streaming/lib/

# Internal portfolio strategy — CV files, LinkedIn assets, an assessment of the other
# projects and what to retire. Useful to the author, and not something a public repository
# should carry: it is about a career, not about this system. Kept on disk, out of the history
# from the commit that removed it.
docs/PORTFOLIO-CONTEXT.md

# Personal notes and explanatory material. A reading aid for the author, not part of the
# repository's public surface — the folder is ignored rather than the file, so anything added
# later is covered by the same decision instead of needing a new one.
notes/
