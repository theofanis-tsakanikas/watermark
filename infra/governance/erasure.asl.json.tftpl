{
  "Comment": "Erase one data subject to a declared boundary, and refuse to certify anything less. See infra/governance/erasure.tf for why the legs are not equal.",
  "StartAt": "RecordTheRequest",
  "States": {
    "RecordTheRequest": {
      "Type": "Pass",
      "Comment": "The request itself is evidence. It is recorded before anything is destroyed, so that a run which fails halfway leaves a trace of what was attempted rather than a subject in an unknown state.",
      "Parameters": {
        "subject_id.$": "$.subject_id",
        "requested_at.$": "$$.Execution.StartTime",
        "execution.$": "$$.Execution.Name",
        "residual_days": ${residual_days}
      },
      "ResultPath": "$.request",
      "Next": "EraseEveryLeg"
    },

    "EraseEveryLeg": {
      "Type": "Parallel",
      "Comment": "Parallel because the legs are independent, and because a sequential run that fails on leg three leaves legs four and five untried — which makes the failure look smaller than it is.",
      "ResultPath": "$.legs",
      "Branches": [
        {
          "StartAt": "ResolveTheSubjectKey",
          "States": {
            "ResolveTheSubjectKey": {
              "Comment": "ScheduleKeyDeletion refuses an alias — 'Key Aliases are not supported for this operation' — and DescribeKey accepts one. So the alias is resolved to a key id first, which is one call and the only way to name a per-subject key without keeping a map of them.",
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:kms:describeKey",
              "Parameters": {
                "KeyId.$": "States.Format('alias/${project}-subject-{}', $.subject_id)"
              },
              "ResultPath": "$.subject_key",
              "Catch": [
                {
                  "Comment": "A missing alias is not automatically a failure and is not automatically a success. Once a subject is shredded the deploy stops declaring their key — that is what keeps a routine apply from resurrecting somebody who asked to be forgotten — so Terraform removes the alias and the *next* request for the same subject finds nothing at all. The question is whether it is missing because they are already gone or because they never had a key, and the two have opposite right answers. `erasure-shredded/` is what tells them apart.",
                  "ErrorEquals": ["Kms.NotFoundException"],
                  "ResultPath": "$.error",
                  "Next": "WasTheKeyAlreadyDestroyed"
                },
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.error",
                  "Next": "ShredFailed"
                }
              ],
              "Next": "AlreadyShredded?"
            },
            "WasTheKeyAlreadyDestroyed": {
              "Type": "Task",
              "Comment": "The marker written when the key was scheduled, read back. Its presence is the only evidence that survives both the seven-day deletion window and the apply that removes the alias — which is exactly why it is written at the moment of the shred rather than assembled from the certificate afterwards.",
              "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
              "Parameters": {
                "Bucket": "${certificate_bucket}",
                "Key.$": "States.Format('erasure-shredded/{}.json', $.subject_id)"
              },
              "ResultPath": "$.marker",
              "Catch": [
                {
                  "Comment": "No alias and no marker. This subject never had a key, so nothing was ever encrypted under one and there is nothing to shred — which is a failure and not an idempotent success, because certifying here would tell somebody they are gone when the mechanism never covered them.",
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.error",
                  "Next": "ShredFailed"
                }
              ],
              "Next": "ShredAlreadyDone"
            },
            "AlreadyShredded?": {
              "Type": "Choice",
              "Comment": "**An erasure must be idempotent, and this one was not.** A second run for the same subject answered `KmsInvalidStateException: key ... is pending deletion` and the whole request refused to certify. In a real deployment that is a person exercising Art. 17 a second time — because they moved, because the first confirmation went to an old address, because they simply asked again — and being handed an error instead of the confirmation they are owed. The key being already scheduled is the leg's promise *kept*, not broken: what the leg guarantees is that the subject's key is gone or going, not that this particular execution is the one that pushed it. So it is confirmed here rather than attempted and failed.",
              "Choices": [
                {
                  "Variable": "$.subject_key.KeyMetadata.KeyState",
                  "StringEquals": "PendingDeletion",
                  "Next": "ShredAlreadyDone"
                }
              ],
              "Default": "CryptoShred"
            },
            "ShredAlreadyDone": {
              "Type": "Pass",
              "Parameters": {
                "leg": "crypto_shred",
                "confirmed": true,
                "note": "The subject key was already scheduled for deletion when this request arrived. The leg's guarantee is that the key is gone or going, and it is."
              },
              "End": true
            },
            "CryptoShred": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:kms:scheduleKeyDeletion",
              "Parameters": {
                "KeyId.$": "$.subject_key.KeyMetadata.KeyId",
                "PendingWindowInDays": 7
              },
              "ResultSelector": {
                "leg": "crypto_shred",
                "confirmed": true,
                "deletes_at.$": "$.DeletionDate"
              },
              "ResultPath": "$.shred",
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.error",
                  "Next": "ShredFailed"
                }
              ],
              "Next": "RecordTheShred"
            },
            "RecordTheShred": {
              "Type": "Task",
              "Comment": "The shred is the irreversible act, so the record of it is written the moment it happens and outlives everything else. Not for the audit trail — for the next deploy. Terraform's job is to make reality match the declaration, and a subject whose key is gone is a subject the declaration still asks for; without a durable marker the next apply creates a fresh key under the same alias and the erasure is quietly undone. The key's own PendingDeletion state is not that marker: it lasts seven days, the alias lasts one apply, and the subject is forever. That was found the hard way, one deploy after the first successful shred.",
              "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
              "Parameters": {
                "Bucket": "${certificate_bucket}",
                "Key.$": "States.Format('erasure-shredded/{}.json', $.subject_id)",
                "Body.$": "States.JsonToString($.shred)",
                "ServerSideEncryption": "aws:kms"
              },
              "ResultSelector": { "leg": "crypto_shred", "confirmed": true },
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.error",
                  "Next": "ShredFailed"
                }
              ],
              "End": true
            },
            "ShredFailed": {
              "Type": "Pass",
              "Parameters": { "leg": "crypto_shred", "confirmed": false },
              "End": true
            }
          }
        },
        {
          "StartAt": "DeleteRowsPhysically",
          "States": {
            "DeleteRowsPhysically": {
              "Type": "Task",
              "Comment": "Bounded by the assignment interval, not by the meter. `IN (SELECT meter_id ...)` erased every reading the meter ever produced, including the readings of whoever held it before or after — `M00007` changes customer at 10:00, so erasing one subject destroyed another's data and the certificate said the boundary held. An erasure that takes more than it was asked for is a breach in the other direction, and it is the harder one to notice because nobody complains that they were forgotten too thoroughly.",
              "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
              "Parameters": {
                "QueryString.$": "States.Format('DELETE FROM ${project}_silver.meter_interval WHERE (meter_id, interval_start) IN (SELECT r.meter_id, r.interval_start FROM ${project}_silver.meter_interval r JOIN ${project}_gold.meter_assignment_scd2 a ON a.meter_id = r.meter_id WHERE a.customer_id = \\'{}\\' AND r.interval_start >= a.valid_from AND (a.valid_to IS NULL OR r.interval_start < a.valid_to))', $.subject_id)",
                "WorkGroup": "${project}"
              },
              "ResultPath": "$.delete",
              "Next": "Compact",
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PhysicalDeleteFailed" }
              ]
            },
            "Compact": {
              "Type": "Task",
              "Comment": "Waited on, not scheduled. The certificate has to state which run removed which files — ADR-0002 kept these jobs precisely so this step can be synchronous.",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": { "JobName": "${compaction_job}" },
              "ResultPath": "$.compaction",
              "Next": "RemoveOrphanFiles",
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PhysicalDeleteFailed" }
              ]
            },
            "RemoveOrphanFiles": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": { "JobName": "${orphan_files_job}" },
              "ResultSelector": { "leg": "lakehouse_rows", "confirmed": true },
              "End": true,
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PhysicalDeleteFailed" }
              ]
            },
            "PhysicalDeleteFailed": {
              "Type": "Pass",
              "Parameters": { "leg": "lakehouse_rows", "confirmed": false },
              "End": true
            }
          }
        },
        {
          "StartAt": "FindTheSubjectsMeters",
          "States": {
            "FindTheSubjectsMeters": {
              "Type": "Task",
              "Comment": "The online store is keyed by meter, and this leg used to hand it a customer id. `DeleteRecord` against an identifier that does not exist is not an error — it returns cleanly — so the leg reported `confirmed: true` having deleted nothing, on every erasure this estate has ever run. The first independent check of it found the subject's record still there. Resolved through the assignment history for the same reason `DeleteRowsPhysically` is: the meter is the join, and the customer is the question.",
              "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
              "Parameters": {
                "QueryString.$": "States.Format('SELECT meter_id FROM ${project}_gold.meter_assignment_scd2 WHERE customer_id = \\'{}\\' AND valid_to IS NULL', $.subject_id)",
                "WorkGroup": "${project}"
              },
              "ResultPath": "$.meters_query",
              "Next": "ReadTheSubjectsMeters",
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "OnlineStoreFailed" }
              ]
            },
            "ReadTheSubjectsMeters": {
              "Type": "Task",
              "Comment": "Only the meters the subject holds *now*. The online store keeps one current value per meter, so a meter they used to hold carries somebody else's number — deleting it would be the over-deletion `DeleteRowsPhysically` is careful to avoid, seen from the other side.",
              "Resource": "arn:aws:states:::aws-sdk:athena:getQueryResults",
              "Parameters": {
                "QueryExecutionId.$": "$.meters_query.QueryExecution.QueryExecutionId"
              },
              "ResultSelector": { "rows.$": "$.ResultSet.Rows[1:]" },
              "ResultPath": "$.meters",
              "Next": "DeleteEachMetersRecord",
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "OnlineStoreFailed" }
              ]
            },
            "DeleteEachMetersRecord": {
              "Type": "Map",
              "Comment": "A subject with no meters deletes nothing and that is correct — but it is also indistinguishable from the bug above, which is why `scripts/erasure_legs_live.py` asks the online store directly rather than reading this leg's own verdict.",
              "ItemsPath": "$.meters.rows",
              "Parameters": {
                "meter.$": "$$.Map.Item.Value.Data[0].VarCharValue",
                "at.$": "$$.Execution.StartTime"
              },
              "Iterator": {
                "StartAt": "SkipTheHeaderRow",
                "States": {
                  "SkipTheHeaderRow": {
                    "Type": "Choice",
                    "Comment": "Athena returns the column names as the first row. The slice above drops it; this refuses to delete a record called `meter_id` if a future Athena ever stops including it, because a no-op that looks like work is what this whole leg was.",
                    "Choices": [
                      { "Variable": "$.meter", "StringEquals": "meter_id", "Next": "NotAMeter" }
                    ],
                    "Default": "DeleteOneMetersRecord"
                  },
                  "NotAMeter": { "Type": "Pass", "End": true },
                  "DeleteOneMetersRecord": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::aws-sdk:sagemakerfeaturestoreruntime:deleteRecord",
                    "Parameters": {
                      "FeatureGroupName": "${project}-meter-consumption",
                      "RecordIdentifierValueAsString.$": "$.meter",
                      "EventTime.$": "$.at"
                    },
                    "End": true
                  }
                }
              },
              "ResultPath": "$.online_deletes",
              "Next": "ConfirmTheOnlineStore",
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "OnlineStoreFailed" }
              ]
            },
            "ConfirmTheOnlineStore": {
              "Type": "Pass",
              "Parameters": { "leg": "online_store", "confirmed": true },
              "End": true
            },
            "OnlineStoreFailed": {
              "Type": "Pass",
              "Parameters": { "leg": "online_store", "confirmed": false },
              "End": true
            }
          }
        },
        {
          "StartAt": "DescribeTheOfflineStore",
          "States": {
            "DescribeTheOfflineStore": {
              "Type": "Task",
              "Comment": "**This branch did not exist.** ErasureScope declared offline_store, the machine produced five legs, and EveryLegConfirmed counted five — so a leg the scope names was absent from the erasure, absent from the certificate, and absent from the check meant to notice it. Four of the subject rows survived an erasure that certified, and the independent verifier found them. SageMaker names the offline store Glue table itself, so the name is asked for rather than assumed.",
              "Resource": "arn:aws:states:::aws-sdk:sagemaker:describeFeatureGroup",
              "Parameters": { "FeatureGroupName": "${project}-meter-consumption" },
              "ResultSelector": {
                "database.$": "$.OfflineStoreConfig.DataCatalogConfig.Database",
                "table.$": "$.OfflineStoreConfig.DataCatalogConfig.TableName"
              },
              "ResultPath": "$.offline",
              "Next": "LetTheOfflineStoreSettle",
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "OfflineStoreFailed" }
              ]
            },
            "LetTheOfflineStoreSettle": {
              "Type": "Wait",
              "Comment": "**The offline store is eventually consistent, and an erasure that does not wait for it is incomplete by exactly the flush window.** `PutRecord` answers from the online store; SageMaker copies to the offline one on its own schedule. The first run of this leg deleted everything present and a record already in flight landed forty-six seconds later — `is_deleted false`, a real feature value, written after the DELETE and found by the independent check.\n\nWaiting is what makes the leg complete rather than bounded. It is correct here because nothing writes this subject once the capture's decision layer has finished; **in production it would not be, and the control there is to stop writing for the subject before erasing rather than to wait longer.** This platform has no such write-block, and that is a real limit rather than one this wait hides.",
              "Seconds": ${offline_store_settle_seconds},
              "Next": "DeleteFromTheOfflineStore"
            },
            "DeleteFromTheOfflineStore": {
              "Type": "Task",
              "Comment": "Bounded by the assignment interval, not by the meter — the same rule as DeleteRowsPhysically and for the same reason. The offline store holds a history of feature values, so each row belongs to whoever held the meter at that instant; M00007 changes customer at 10:00, and taking the predecessor rows would be the over-deletion the lakehouse leg goes out of its way to avoid. The event time is a String with nine fractional digits, the one shape an Iceberg offline store accepts, so it is narrowed to milliseconds before it can be compared to a timestamp.",
              "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
              "Parameters": {
                "QueryString.$": "States.Format('DELETE FROM {}.{} WHERE (meter_id, event_time) IN (SELECT f.meter_id, f.event_time FROM {}.{} f JOIN ${project}_gold.meter_assignment_scd2 a ON a.meter_id = f.meter_id WHERE a.customer_id = \\'{}\\' AND cast(from_iso8601_timestamp(substr(f.event_time, 1, 23) || \\'Z\\') as timestamp) >= a.valid_from AND (a.valid_to IS NULL OR cast(from_iso8601_timestamp(substr(f.event_time, 1, 23) || \\'Z\\') as timestamp) < a.valid_to))', $.offline.database, $.offline.table, $.offline.database, $.offline.table, $.subject_id)",
                "WorkGroup": "${project}"
              },
              "ResultPath": "$.offline_delete",
              "Next": "ConfirmTheOfflineStore",
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "OfflineStoreFailed" }
              ]
            },
            "ConfirmTheOfflineStore": {
              "Type": "Pass",
              "Parameters": { "leg": "offline_store", "confirmed": true },
              "End": true
            },
            "OfflineStoreFailed": {
              "Type": "Pass",
              "Parameters": { "leg": "offline_store", "confirmed": false },
              "End": true
            }
          }
        },
        {
          "StartAt": "RederiveTrainingSets",
          "States": {
            "RederiveTrainingSets": {
              "Type": "Task",
              "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
              "Parameters": {
                "QueryString.$": "States.Format('DELETE FROM ${project}_gold.training_snapshot WHERE customer_id = \\'{}\\'', $.subject_id)",
                "WorkGroup": "${project}"
              },
              "ResultSelector": { "leg": "training_sets", "confirmed": true },
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "TrainingSetsFailed" }
              ],
              "End": true
            },
            "TrainingSetsFailed": {
              "Type": "Pass",
              "Parameters": { "leg": "training_sets", "confirmed": false },
              "End": true
            }
          }
        },
        {
          "StartAt": "QuarantineAffectedModels",
          "States": {
            "QuarantineAffectedModels": {
              "Type": "Pass",
              "Comment": "The leg that cannot be completed. A model trained before this request keeps the subject's contribution in its weights; no key protects that and destroying one does not remove it. What this leg does is quarantine the model and start the retraining clock. The residual window goes on the certificate. Machine unlearning is not claimed.",
              "Parameters": {
                "leg": "model_artefacts",
                "confirmed": true,
                "boundary": "declared",
                "residual_days": ${residual_days},
                "note": "Models trained before this request retain the subject statistically. They are quarantined and retrained from the shredded corpus within the residual window; crypto-shredding does not reach model weights and machine unlearning is not claimed."
              },
              "End": true
            }
          }
        }
      ],
      "Next": "CountTheLegs"
    },

    "CountTheLegs": {
      "Type": "Pass",
      "Comment": "**Counted, not enumerated — and the difference is a whole leg.** This used to be a five-way AND over $.legs[0] through $.legs[4]. `ErasureScope` declares six; the machine produced five; nothing anywhere compared the two lists, so `offline_store` was absent from the erasure and the refusal was written to expect exactly the legs that happened to be there. A hand-counted condition cannot notice a missing leg, because the missing leg is what changes the count.\n\nTwo questions instead. `expected` comes from Terraform, which takes it from the same list `scripts/check_erasure_legs.py` holds equal to `ErasureScope.legs` — so adding a leg to the scope and forgetting the branch turns CI red rather than the certificate quiet. And `refused` asks whether any leg came back false, which is the question the old condition was written to ask.",
      "Parameters": {
        "subject_id.$": "$.subject_id",
        "request.$": "$.request",
        "legs.$": "$.legs",
        "counted.$": "States.ArrayLength($.legs)",
        "refused.$": "States.ArrayContains($.legs[*].confirmed, false)"
      },
      "Next": "EveryLegConfirmed"
    },
    "EveryLegConfirmed": {
      "Type": "Choice",
      "Comment": "The refusal. This is what claim 6 actually delivers — not a deletion mechanism, but a system that will not say 'erased' unless every leg the scope declares came back confirmed.",
      "Choices": [
        {
          "And": [
            { "Variable": "$.counted", "NumericEquals": ${declared_legs} },
            { "Variable": "$.refused", "BooleanEquals": false }
          ],
          "Next": "WriteTheCertificate"
        }
      ],
      "Default": "RefuseToCertify"
    },

    "WriteTheCertificate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Comment": "`States.JsonToString`, not the object. S3's `PutObject` takes a string body and Step Functions does not serialise one for you — an object here fails the task with a type error, which would mean an erasure that completed every leg and then failed to record that it had. Neither PutObject in this file had ever run successfully, so neither had ever been checked.",
      "Parameters": {
        "Bucket": "${certificate_bucket}",
        "Key.$": "States.Format('erasure-certificates/{}/{}.json', $.request.subject_id, $$.Execution.Name)",
        "Body.$": "States.JsonToString($)",
        "ServerSideEncryption": "aws:kms"
      },
      "End": true
    },

    "RefuseToCertify": {
      "Type": "Fail",
      "Error": "IncompleteErasure",
      "Cause": "At least one leg did not confirm. No certificate is written. A partial erasure reported as complete is worse than none: the subject is told they are gone and the residual becomes invisible."
    }
  }
}
