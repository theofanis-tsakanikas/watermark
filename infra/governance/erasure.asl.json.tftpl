{
  "Comment": "Erase one data subject to a declared boundary, and refuse to certify anything less. See infra/governance/erasure.tf for why the legs are not equal.",
  "StartAt": "RecordTheRequest",
  "States": {
    "RecordTheRequest": {
      "Type": "Pass",
      "Comment": "The request itself is evidence. It is recorded before anything is destroyed, so that a run which fails halfway leaves a trace of what was attempted rather than a subject in an unknown state.",
      "Parameters": {
        "subject_id.$": "$.subject_id",
        "requested_at.$": "$$.Execution.StartTime",
        "execution.$": "$$.Execution.Name",
        "residual_days": ${residual_days}
      },
      "ResultPath": "$.request",
      "Next": "EraseEveryLeg"
    },

    "EraseEveryLeg": {
      "Type": "Parallel",
      "Comment": "Parallel because the legs are independent, and because a sequential run that fails on leg three leaves legs four and five untried — which makes the failure look smaller than it is.",
      "ResultPath": "$.legs",
      "Branches": [
        {
          "StartAt": "ResolveTheSubjectKey",
          "States": {
            "ResolveTheSubjectKey": {
              "Comment": "ScheduleKeyDeletion refuses an alias — 'Key Aliases are not supported for this operation' — and DescribeKey accepts one. So the alias is resolved to a key id first, which is one call and the only way to name a per-subject key without keeping a map of them.",
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:kms:describeKey",
              "Parameters": {
                "KeyId.$": "States.Format('alias/${project}-subject-{}', $.subject_id)"
              },
              "ResultPath": "$.subject_key",
              "Catch": [
                {
                  "Comment": "A missing alias is not automatically a failure and is not automatically a success. Once a subject is shredded the deploy stops declaring their key — that is what keeps a routine apply from resurrecting somebody who asked to be forgotten — so Terraform removes the alias and the *next* request for the same subject finds nothing at all. The question is whether it is missing because they are already gone or because they never had a key, and the two have opposite right answers. `erasure-shredded/` is what tells them apart.",
                  "ErrorEquals": ["Kms.NotFoundException"],
                  "ResultPath": "$.error",
                  "Next": "WasTheKeyAlreadyDestroyed"
                },
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.error",
                  "Next": "ShredFailed"
                }
              ],
              "Next": "AlreadyShredded?"
            },
            "WasTheKeyAlreadyDestroyed": {
              "Type": "Task",
              "Comment": "The marker written when the key was scheduled, read back. Its presence is the only evidence that survives both the seven-day deletion window and the apply that removes the alias — which is exactly why it is written at the moment of the shred rather than assembled from the certificate afterwards.",
              "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
              "Parameters": {
                "Bucket": "${certificate_bucket}",
                "Key.$": "States.Format('erasure-shredded/{}.json', $.subject_id)"
              },
              "ResultPath": "$.marker",
              "Catch": [
                {
                  "Comment": "No alias and no marker. This subject never had a key, so nothing was ever encrypted under one and there is nothing to shred — which is a failure and not an idempotent success, because certifying here would tell somebody they are gone when the mechanism never covered them.",
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.error",
                  "Next": "ShredFailed"
                }
              ],
              "Next": "ShredAlreadyDone"
            },
            "AlreadyShredded?": {
              "Type": "Choice",
              "Comment": "**An erasure must be idempotent, and this one was not.** A second run for the same subject answered `KmsInvalidStateException: key ... is pending deletion` and the whole request refused to certify. In a real deployment that is a person exercising Art. 17 a second time — because they moved, because the first confirmation went to an old address, because they simply asked again — and being handed an error instead of the confirmation they are owed. The key being already scheduled is the leg's promise *kept*, not broken: what the leg guarantees is that the subject's key is gone or going, not that this particular execution is the one that pushed it. So it is confirmed here rather than attempted and failed.",
              "Choices": [
                {
                  "Variable": "$.subject_key.KeyMetadata.KeyState",
                  "StringEquals": "PendingDeletion",
                  "Next": "ShredAlreadyDone"
                }
              ],
              "Default": "CryptoShred"
            },
            "ShredAlreadyDone": {
              "Type": "Pass",
              "Parameters": {
                "leg": "crypto_shred",
                "confirmed": true,
                "note": "The subject key was already scheduled for deletion when this request arrived. The leg's guarantee is that the key is gone or going, and it is."
              },
              "End": true
            },
            "CryptoShred": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:kms:scheduleKeyDeletion",
              "Parameters": {
                "KeyId.$": "$.subject_key.KeyMetadata.KeyId",
                "PendingWindowInDays": 7
              },
              "ResultSelector": {
                "leg": "crypto_shred",
                "confirmed": true,
                "deletes_at.$": "$.DeletionDate"
              },
              "ResultPath": "$.shred",
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.error",
                  "Next": "ShredFailed"
                }
              ],
              "Next": "RecordTheShred"
            },
            "RecordTheShred": {
              "Type": "Task",
              "Comment": "The shred is the irreversible act, so the record of it is written the moment it happens and outlives everything else. Not for the audit trail — for the next deploy. Terraform's job is to make reality match the declaration, and a subject whose key is gone is a subject the declaration still asks for; without a durable marker the next apply creates a fresh key under the same alias and the erasure is quietly undone. The key's own PendingDeletion state is not that marker: it lasts seven days, the alias lasts one apply, and the subject is forever. That was found the hard way, one deploy after the first successful shred.",
              "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
              "Parameters": {
                "Bucket": "${certificate_bucket}",
                "Key.$": "States.Format('erasure-shredded/{}.json', $.subject_id)",
                "Body.$": "States.JsonToString($.shred)",
                "ServerSideEncryption": "aws:kms"
              },
              "ResultSelector": { "leg": "crypto_shred", "confirmed": true },
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.error",
                  "Next": "ShredFailed"
                }
              ],
              "End": true
            },
            "ShredFailed": {
              "Type": "Pass",
              "Parameters": { "leg": "crypto_shred", "confirmed": false },
              "End": true
            }
          }
        },
        {
          "StartAt": "DeleteRowsPhysically",
          "States": {
            "DeleteRowsPhysically": {
              "Type": "Task",
              "Comment": "Bounded by the assignment interval, not by the meter. `IN (SELECT meter_id ...)` erased every reading the meter ever produced, including the readings of whoever held it before or after — `M00007` changes customer at 10:00, so erasing one subject destroyed another's data and the certificate said the boundary held. An erasure that takes more than it was asked for is a breach in the other direction, and it is the harder one to notice because nobody complains that they were forgotten too thoroughly.",
              "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
              "Parameters": {
                "QueryString.$": "States.Format('DELETE FROM ${project}_silver.meter_interval WHERE (meter_id, interval_start) IN (SELECT r.meter_id, r.interval_start FROM ${project}_silver.meter_interval r JOIN ${project}_gold.meter_assignment_scd2 a ON a.meter_id = r.meter_id WHERE a.customer_id = \\'{}\\' AND r.interval_start >= a.valid_from AND (a.valid_to IS NULL OR r.interval_start < a.valid_to))', $.subject_id)",
                "WorkGroup": "${project}"
              },
              "ResultPath": "$.delete",
              "Next": "Compact",
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PhysicalDeleteFailed" }
              ]
            },
            "Compact": {
              "Type": "Task",
              "Comment": "Waited on, not scheduled. The certificate has to state which run removed which files — ADR-0002 kept these jobs precisely so this step can be synchronous.",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": { "JobName": "${compaction_job}" },
              "ResultPath": "$.compaction",
              "Next": "RemoveOrphanFiles",
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PhysicalDeleteFailed" }
              ]
            },
            "RemoveOrphanFiles": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": { "JobName": "${orphan_files_job}" },
              "ResultSelector": { "leg": "physical_deletion", "confirmed": true },
              "End": true,
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PhysicalDeleteFailed" }
              ]
            },
            "PhysicalDeleteFailed": {
              "Type": "Pass",
              "Parameters": { "leg": "physical_deletion", "confirmed": false },
              "End": true
            }
          }
        },
        {
          "StartAt": "DeleteFromTheOnlineStore",
          "States": {
            "DeleteFromTheOnlineStore": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:sagemakerfeaturestoreruntime:deleteRecord",
              "Parameters": {
                "FeatureGroupName": "${project}-meter-consumption",
                "RecordIdentifierValueAsString.$": "$.subject_id",
                "EventTime.$": "$$.Execution.StartTime"
              },
              "ResultSelector": { "leg": "online_store", "confirmed": true },
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "OnlineStoreFailed" }
              ],
              "End": true
            },
            "OnlineStoreFailed": {
              "Type": "Pass",
              "Parameters": { "leg": "online_store", "confirmed": false },
              "End": true
            }
          }
        },
        {
          "StartAt": "RederiveTrainingSets",
          "States": {
            "RederiveTrainingSets": {
              "Type": "Task",
              "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
              "Parameters": {
                "QueryString.$": "States.Format('DELETE FROM ${project}_gold.training_snapshot WHERE customer_id = \\'{}\\'', $.subject_id)",
                "WorkGroup": "${project}"
              },
              "ResultSelector": { "leg": "training_sets", "confirmed": true },
              "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "TrainingSetsFailed" }
              ],
              "End": true
            },
            "TrainingSetsFailed": {
              "Type": "Pass",
              "Parameters": { "leg": "training_sets", "confirmed": false },
              "End": true
            }
          }
        },
        {
          "StartAt": "QuarantineAffectedModels",
          "States": {
            "QuarantineAffectedModels": {
              "Type": "Pass",
              "Comment": "The leg that cannot be completed. A model trained before this request keeps the subject's contribution in its weights; no key protects that and destroying one does not remove it. What this leg does is quarantine the model and start the retraining clock. The residual window goes on the certificate. Machine unlearning is not claimed.",
              "Parameters": {
                "leg": "model_artefacts",
                "confirmed": true,
                "boundary": "declared",
                "residual_days": ${residual_days},
                "note": "Models trained before this request retain the subject statistically. They are quarantined and retrained from the shredded corpus within the residual window; crypto-shredding does not reach model weights and machine unlearning is not claimed."
              },
              "End": true
            }
          }
        }
      ],
      "Next": "EveryLegConfirmed"
    },

    "EveryLegConfirmed": {
      "Type": "Choice",
      "Comment": "The refusal. This is what claim 6 actually delivers — not a deletion mechanism, but a system that will not say 'erased' unless every leg came back confirmed.",
      "Choices": [
        {
          "And": [
            { "Variable": "$.legs[0].confirmed", "BooleanEquals": true },
            { "Variable": "$.legs[1].confirmed", "BooleanEquals": true },
            { "Variable": "$.legs[2].confirmed", "BooleanEquals": true },
            { "Variable": "$.legs[3].confirmed", "BooleanEquals": true },
            { "Variable": "$.legs[4].confirmed", "BooleanEquals": true }
          ],
          "Next": "WriteTheCertificate"
        }
      ],
      "Default": "RefuseToCertify"
    },

    "WriteTheCertificate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Comment": "`States.JsonToString`, not the object. S3's `PutObject` takes a string body and Step Functions does not serialise one for you — an object here fails the task with a type error, which would mean an erasure that completed every leg and then failed to record that it had. Neither PutObject in this file had ever run successfully, so neither had ever been checked.",
      "Parameters": {
        "Bucket": "${certificate_bucket}",
        "Key.$": "States.Format('erasure-certificates/{}/{}.json', $.request.subject_id, $$.Execution.Name)",
        "Body.$": "States.JsonToString($)",
        "ServerSideEncryption": "aws:kms"
      },
      "End": true
    },

    "RefuseToCertify": {
      "Type": "Fail",
      "Error": "IncompleteErasure",
      "Cause": "At least one leg did not confirm. No certificate is written. A partial erasure reported as complete is worse than none: the subject is told they are gone and the residual becomes invisible."
    }
  }
}
